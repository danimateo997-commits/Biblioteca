{
  "name": "api-tareas",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node src/app.js",
    "start:prod": "prisma migrate deploy --config prisma7.config.ts && node src/app.js",
    "dev": "node --watch src/app.js",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:migrate": "prisma migrate deploy --config prisma7.config.ts",
    "db:studio": "prisma studio --config prisma7.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "prisma": "^7.10.1",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.5"
    
  }
}
